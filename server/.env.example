# Copy to server/.env  (cp server/.env.example server/.env)

# --- Google sign-in ("Sign in with Google"). Public OAuth Client ID — no secret needed.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:4000 and http://localhost:5173
GOOGLE_CLIENT_ID=

# --- Database. Leave commented to use the built-in local database (server/data/pg).
# To use Supabase Postgres, uncomment and put your database password instead of [YOUR-PASSWORD]
# (Supabase → Project Settings → Database → Reset database password, if you lost it).
# DATABASE_URL=postgresql://postgres.sgnvdmhhcebiitukdlmm:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- App
PORT=4000
# MASTER_LOGIN=master
# MASTER_PASSWORD=master123
# JWT_SECRET=   (auto-generated into server/data/.jwt-secret if empty)
# TELEGRAM_BOT=   (bot username for payments — next stage)
